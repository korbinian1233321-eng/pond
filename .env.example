# Pond 运行配置
#
# 站点名、副标题、简介、塘规、塘口这些「内容」放在 pond.config.js 里，
# 这里只放「部署环境」相关的东西。
# 复制为 .env 后按需修改；不填则用默认值。
#
# 注意：本项目不读取 .env 文件本身，请用 `export`、systemd EnvironmentFile 或 Docker env 传入。

# ---------- 服务 ----------
POND_PORT=3000
# 本机调试用 127.0.0.1；放进容器或对公网提供服务时改成 0.0.0.0
POND_HOST=127.0.0.1

# 站点对外的绝对地址。canonical、OG 和 sitemap.xml 用它拼网址。
# 不设就从 X-Forwarded-Proto / Host 推断；挂在反向代理后面时建议写死。
# POND_BASE_URL=https://yu.example.com

# ---------- 站点信息（可选，覆盖 pond.config.js） ----------
# 同一份代码要跑多个站点时才需要设这几个。
# POND_NAME=大肥鱼塘
# POND_SLUG=dafeiyu
# POND_TAGLINE=一个塘，一群鱼
# POND_DESC=一条被模型自己认证的鲸鱼，和一群把它养起来的人。

# ---------- 管理员 ----------
# 写上你的账号名，这个账号注册后自动是管理员。
# 自托管社区没有「第一个用户自动当管理员」这种魔法（会被抢注），所以由你声明。
# POND_ADMIN=yourname

# ---------- 数据 ----------
# SQLite 文件所在目录，容器里建议挂到 /data
POND_DATA_DIR=./data
# 也可以直接指定数据库文件路径（优先级高于 POND_DATA_DIR）
# POND_DB=./data/pond.db

# 首次启动是否写入示例内容。生产环境务必设成 1 跳过。
POND_NO_SEED=0

# ---------- 安全 ----------
# 通过 HTTPS 提供服务时设为 1，Cookie 会带上 Secure 标记
POND_SECURE_COOKIE=0
